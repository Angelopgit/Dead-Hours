{
  "name": "dead-hours",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "start": "npm start -w server",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w client && npm run typecheck -w server",
    "check:world": "tsx client/tests/world.check.ts",
    "check:houses": "tsx client/tests/houses.check.ts",
    "check:audio": "tsx client/tests/audio.check.ts",
    "check:sim": "tsx shared/tests/sim.check.ts",
    "check:raid": "tsx shared/tests/raid.check.ts",
    "check:server": "npm run check -w server",
    "check:cluster": "npm run check:cluster -w server",
    "check:controls": "tsx client/tests/controls.check.ts",
    "check:sights": "tsx client/tests/sights.check.ts",
    "check:explosives": "tsx shared/tests/explosives.check.ts",
    "check:skate": "tsx shared/tests/skateboards.check.ts && tsx server/tests/skate.check.ts",
    "check:windows": "tsx server/tests/vault.check.ts",
    "check:vehicles": "tsx shared/tests/vehicles.check.ts && tsx server/tests/vehicles.check.ts",
    "check:bike": "tsx shared/tests/bicycles.check.ts && tsx server/tests/bike.check.ts",
    "textures": "node client/tools/textures/generate.mjs && node client/tools/textures/encode.mjs",
    "textures:cc0": "node client/tools/textures/generate.mjs && node client/tools/textures/fetch-cc0.mjs && node client/tools/textures/encode.mjs"
  }
}
