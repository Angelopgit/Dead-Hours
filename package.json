{
  "name": "dead-hours",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "start": "npm start -w server",
    "build": "npm run build -w client",
    "build:single": "npm run build:single -w client",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w client && npm run typecheck -w server",
    "lint": "eslint shared/src shared/tests client/src client/tests client/dev server/src server/tests",
    "check": "node scripts/check-all.mjs",
    "check:world": "tsx client/tests/world.check.ts",
    "check:houses": "tsx client/tests/houses.check.ts",
    "check:grass": "tsx client/tests/grass.check.ts",
    "check:trees": "tsx client/tests/trees.check.ts",
    "check:render": "tsx client/tests/render.check.ts",
    "check:audio": "tsx client/tests/audio.check.ts",
    "check:sim": "tsx shared/tests/sim.check.ts",
    "check:raid": "tsx shared/tests/raid.check.ts",
    "check:goals": "tsx shared/tests/goals.check.ts",
    "check:server": "npm run check -w server",
    "check:cluster": "npm run check:cluster -w server",
    "check:controls": "tsx client/tests/controls.check.ts",
    "check:sights": "tsx client/tests/sights.check.ts",
    "check:melee": "tsx client/tests/melee.check.ts",
    "check:models": "tsx client/tests/models.check.ts",
    "check:explosives": "tsx shared/tests/explosives.check.ts",
    "check:destruction": "tsx shared/tests/destruction.check.ts",
    "check:skate": "tsx shared/tests/skateboards.check.ts && tsx server/tests/skate.check.ts",
    "check:windows": "tsx server/tests/vault.check.ts",
    "check:vehicles": "tsx shared/tests/vehicles.check.ts && tsx server/tests/vehicles.check.ts && tsx client/tests/vehicles.check.ts",
    "check:bike": "tsx shared/tests/bicycles.check.ts && tsx server/tests/bike.check.ts",
    "check:boosts": "tsx server/tests/boosts.check.ts",
    "balance:guns": "tsx shared/tests/guns.ts",
    "trailer": "node client/tools/trailer/render.mjs",
    "trailer:cut": "node client/tools/trailer/assemble.mjs",
    "textures": "node client/tools/textures/generate.mjs && node client/tools/textures/encode.mjs",
    "textures:cc0": "node client/tools/textures/generate.mjs && node client/tools/textures/fetch-cc0.mjs && node client/tools/textures/encode.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript-eslint": "8.71.2"
  }
}
