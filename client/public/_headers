# Cache rules for the static host (Cloudflare Pages and Netlify read this file from the build output).
# Build files carry a hash of their contents in the name, so a browser can keep them for good: a new
# version of a file is a new name. Textures are asked for with ?v=<manifest version>, which changes
# whenever they are encoded again. The page and the texture manifest are checked on every visit.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/textures/world/:set/:file
  Cache-Control: public, max-age=31536000, immutable

/textures/world/manifest.json
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
